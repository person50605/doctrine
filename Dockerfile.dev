# Development Dockerfile with hot-reloading
FROM node:16-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm install

# Copy source code
COPY . .

# Expose port 8080 (Vue CLI default)
EXPOSE 8080

# Start development server
CMD ["npm", "run", "serve"]